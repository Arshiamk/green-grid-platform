# Environment Variables Template
# Copy this file to .env and adjust the values.

DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Host used when running Django directly on your machine.
# Inside docker-compose the containers override this to point at the `db` service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greengrid
REDIS_URL=redis://localhost:6379/1

# Production security (only read when DEBUG=0)
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000

# Stripe (test keys are fine; payments are optional)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
